# Thorpe Desktop Application Environment Variables

# OpenAI API (optional — Jonathan works offline with local diagnostics)
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Alternative AI providers (future)
# ANTHROPIC_API_KEY=
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_API_KEY=

# Application
VITE_APP_NAME=Thorpe
VITE_APP_VERSION=1.0.0
VITE_DEFAULT_LICENSE_TIER=free

# Update server (optional)
VITE_UPDATE_ENDPOINT=https://updates.thorpe.app/v1/check

# Telemetry (disabled by default)
VITE_TELEMETRY_ENABLED=false
