# Backend
SCOUTAI_CORS_ORIGINS=http://localhost:3000
SCOUTAI_DEMO_MODE=auto

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=ScoutAI
