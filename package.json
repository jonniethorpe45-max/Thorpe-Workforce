{
  "name": "thorpe",
  "version": "1.1.0",
  "description": "Thorpe — AI-powered IT support platform",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "test": "vitest run",
    "test:e2e": "vitest run tests/e2e",
    "test:all": "bash scripts/e2e.sh",
    "test:watch": "vitest",
    "pack-sign": "cargo run --manifest-path src-tauri/Cargo.toml --bin thorpe-pack-sign --",
    "license-key": "cargo run --manifest-path src-tauri/Cargo.toml --bin thorpe-license-key --",
    "lint": "tsc --noEmit",
    "patent:package": "node scripts/build-patent-package.mjs",
    "patent:problems-pdf": "node scripts/export-patent-single-pdf.mjs docs/patents/10-PROBLEMS-SOLVED-FOR-COUNSEL.md Thorpe-Desktop-Problems-Solved-For-Counsel",
    "patent:solution-pdf": "node scripts/export-patent-single-pdf.mjs docs/patents/11-SOLUTION-OFFERED-FOR-COUNSEL.md Thorpe-Desktop-Solution-Offered-For-Counsel"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.2.0",
    "@tauri-apps/plugin-dialog": "^2.2.0",
    "@tauri-apps/plugin-fs": "^2.2.0",
    "@tauri-apps/plugin-shell": "^2.2.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^11.15.0",
    "lucide-react": "^0.469.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.1.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.2.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^26.0.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.6",
    "vitest": "^2.1.8"
  }
}
